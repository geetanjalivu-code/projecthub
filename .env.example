# Copy this file to `.env` in the project root, then restart `npm run dev`.
# Values come from: Supabase Dashboard → Project Settings → API

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key ONLY (Settings → API → Project API keys → anon public)
# Never put the service_role secret in this file. That key is server-only.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
